# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5500

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=mge_db

# Optional single connection string (overrides the above if set)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/mge_db

# SMTP — email notifications for enquiries + quote requests.
# For Gmail: enable 2FA on your Google account, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=youraccount@gmail.com
SMTP_PASS=
MAIL_FROM="M. Gyamprah Enterprise <youraccount@gmail.com>"
# Where admin notifications are sent (defaults to SMTP_USER if unset).
MAIL_ADMIN=youraccount@gmail.com
